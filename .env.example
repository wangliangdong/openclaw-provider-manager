# Copy to .env and fill in. NEVER commit the real .env.
#
#   cp .env.example .env
#
# .env is listed in .gitignore; `docker compose` reads it automatically.

# ---------------------------------------------------------------------------
# Gateway connection (required)
# ---------------------------------------------------------------------------

# The Gateway's shared token. Without it, reads work but every write fails.
#
# Find it with:  openclaw gateway auth-token --show
OPENCLAW_GATEWAY_TOKEN=

# How this container reaches the Gateway. Default assumes both containers
# share a Docker network and the Gateway is named `openclaw-gateway`.
#
# If the Gateway runs on the host instead of in a container, and you are on
# Linux:            http://172.17.0.1:18789
# Docker Desktop:   http://host.docker.internal:18789
OPENCLAW_GATEWAY_URL=http://openclaw-gateway:18789

# Name of the external Docker network the Gateway is attached to.
OPENCLAW_NETWORK=openclaw-net

# ---------------------------------------------------------------------------
# UI login (optional)
# ---------------------------------------------------------------------------

# Leave empty for no login. Set a value to require it before the UI accepts
# any change. Reads stay open either way.
PM_ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# Encrypted vault (optional, but required for "refresh models on an existing
# provider" — see README section 3)
# ---------------------------------------------------------------------------

# base64 of exactly 32 random bytes. Generate ONE and keep it stable:
#     head -c 32 /dev/urandom | base64
#
# Leave empty to disable the vault. Everything else keeps working; you just
# cannot refresh an already-saved provider without re-typing its key.
#
# Losing this key is recoverable: re-import with scripts/import_keys.py.
PM_VAULT_KEY=

# ---------------------------------------------------------------------------
# Ports
# ---------------------------------------------------------------------------

# Host-side bind address and port for the UI.
# 127.0.0.1 = loopback only (safest). Use 0.0.0.0 to expose on the LAN.
PM_HOST_BIND=127.0.0.1
PM_HOST_PORT=8891
